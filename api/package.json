{
  "name": "bjj-api",
  "version": "1.0.0",
  "description": "A secure API for a BJJ gym",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "npm run db:test:create && jest --detectOpenHandles",
    "test:watch": "npm run db:test:create && jest --watch",
    "db:test:create": "cross-env NODE_ENV=test node scripts/createTestDb.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "sequelize": "^6.35.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "cross-env": "^7.0.3"
  }
}